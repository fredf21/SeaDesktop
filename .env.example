# ─────────────────────────────────────────────────────────────────
# .env.example — Template des variables sensibles pour docker-compose
# ─────────────────────────────────────────────────────────────────
#
# Copier ce fichier en .env (gitignore) et remplir avec des valeurs
# reelles avant `docker compose up` :
#
#   cp .env.example .env
#   nano .env
#
# Le .env est lu automatiquement par docker compose lors du up.
# ─────────────────────────────────────────────────────────────────


# Secret de signature JWT. DOIT etre genere aleatoirement, longueur
# minimum 32 caracteres. Ne JAMAIS commiter ce secret reel.
# Pour generer :
#   openssl rand -base64 48
SEA_DESKTOP_JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars


# Mot de passe root MySQL. Utilise par MySQL au demarrage du
# container et par les services backend pour se connecter.
MYSQL_ROOT_PASSWORD=replace_me_with_a_strong_password


# Dossier hote contenant les YAML projet. Monte en lecture/ecriture
# dans chaque container backend sous /app/configs.
#
# Defaut : ./configs (dossier relatif au docker-compose.yml).
# En production, pointer vers un emplacement persistant :
#   SEA_DESKTOP_CONFIGS_HOST_DIR=/var/lib/seadesktop/configs
SEA_DESKTOP_CONFIGS_HOST_DIR=./configs
